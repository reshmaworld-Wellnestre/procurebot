# Set this to chat with the real Claude. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Set PROCUREBOT_DEMO_MODE=1 to run the bot with scripted, canned responses
# instead of calling Claude. The chat UI works the same way — same tool calls,
# same audit log — but no API key is required and no API calls are made.
# Great for screenshots, demos, and offline testing.
PROCUREBOT_DEMO_MODE=

PROCUREBOT_DB_URL=sqlite:///./procurebot.db
PROCUREBOT_MODEL=claude-opus-4-7
